<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>qa.fanar</groupId>
        <artifactId>fanar-java</artifactId>
        <version>0.5.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fanar-java-test-support</artifactId>
    <packaging>jar</packaging>

    <name>Fanar Java :: Test Support</name>
    <description>In-JVM test fixtures shared by the reactor's *IntegrationTest classes — a scripted loopback HttpServer and a collecting Flow.Subscriber. JDK-only (no dependency on fanar-core, so core's own tests use it too). Never published.</description>

    <!--
      A test fixture, not a library: never deployed, no coverage gate. It IS installed locally so
      `./mvnw -pl <module> -am verify` resolves it from the reactor like any sibling.
      dependency:analyze stays on — the module has no dependencies to get wrong.
    -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
