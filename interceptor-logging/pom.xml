<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>qa.fanar</groupId>
        <artifactId>fanar-java</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fanar-interceptor-logging</artifactId>
    <packaging>jar</packaging>

    <name>Fanar Java :: Interceptor :: Logging</name>
    <description>Wire-level logging Interceptor for the Fanar SDK — OkHttp-style level ladder, SLF4J sink by default, configurable header redaction and body-byte cap, streaming-aware.</description>

    <dependencies>
        <dependency>
            <groupId>qa.fanar</groupId>
            <artifactId>fanar-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Same provided-scope pattern as obs-slf4j: the consuming application supplies the
             SLF4J runtime (Logback, slf4j-simple, JUL bridge, etc.). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Quiet SLF4J's "no provider" warning when the default sink is exercised from tests. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Scripted loopback HttpServer for the *IntegrationTest classes (JDK-only, never published). -->
        <dependency>
            <groupId>qa.fanar</groupId>
            <artifactId>fanar-java-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Real wire JSON for the *IntegrationTest classes — the seam test decodes what Fanar sends.
             Never imported: FanarClient discovers the codec through ServiceLoader (ADR-008), which is
             also what keeps this module's test code from needing to read the codec's JPMS module. -->
        <dependency>
            <groupId>qa.fanar</groupId>
            <artifactId>fanar-json-jackson3</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Runtime of that codec: fanar-json-jackson3 declares Jackson `provided`, and on the test
             module path the codec (a FanarJsonCodec provider) must resolve tools.jackson.databind.
             No compile-time imports — whitelisted for dependency:analyze in the root pom. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
